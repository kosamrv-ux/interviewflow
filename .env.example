# ============================================================
# InterviewFlow — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─── Phoenix / Elixir ───────────────────────────────────────
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=replace_with_64_char_random_string_run_mix_phx_gen_secret

# Generate with: mix phx.gen.secret
GUARDIAN_SECRET_KEY=replace_with_64_char_random_string_for_jwt_signing

# Phoenix server host (without scheme). Used for cookie domain and WebSocket origins.
PHX_HOST=localhost

# Port the Phoenix app listens on inside the container
PORT=4000

# Mix environment: dev | test | prod
MIX_ENV=dev

# ─── Database ───────────────────────────────────────────────
# Full PostgreSQL connection URL
DATABASE_URL=postgres://interviewflow:interviewflow@localhost:5432/interviewflow_dev

# Test database (separate DB to avoid wiping dev data with mix test)
TEST_DATABASE_URL=postgres://interviewflow:interviewflow@localhost:5432/interviewflow_test

# Ecto repo pool size (number of DB connections per Phoenix node)
POOL_SIZE=10

# ─── Redis ──────────────────────────────────────────────────
# Redis connection URL. Used for Phoenix PubSub, session state, and rate limiting.
REDIS_URL=redis://localhost:6379/0

# ─── Twilio (WebRTC TURN credentials) ───────────────────────
# Required for video interviews to work through NAT/firewalls.
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TTL in seconds for Twilio TURN credentials (max 86400)
TWILIO_ICE_TTL=86400

# ─── GCP ────────────────────────────────────────────────────
# GCP project ID for Vertex AI and Cloud Storage
GCP_PROJECT_ID=your-gcp-project-id

# Cloud Storage bucket for interview recordings and uploaded resumes
GCS_BUCKET_NAME=interviewflow-dev-recordings

# Path to GCP service account JSON key file (for local dev only).
# In Cloud Run, use Workload Identity instead.
GCP_CREDENTIALS_FILE=./gcp-credentials.json

# ─── Vertex AI (AI Scoring Service) ─────────────────────────
# GCP region where your Vertex AI model is deployed
VERTEX_AI_LOCATION=us-central1

# Vertex AI endpoint URL (leave blank to use the default Gemini API endpoint)
VERTEX_AI_ENDPOINT=

# Gemini model ID to use for scoring
VERTEX_AI_MODEL=gemini-1.5-pro-002

# ─── AI Service ─────────────────────────────────────────────
# Internal URL of the Python AI scoring service (within Docker network)
AI_SERVICE_URL=http://ai_service:8000

# Shared secret for authenticating requests from Phoenix to AI service
AI_SERVICE_SECRET=replace_with_random_32_char_string

# ─── Email (Swoosh) ─────────────────────────────────────────
# Adapter: local (dev, uses LiveDashboard mailbox) | sendgrid | smtp
EMAIL_ADAPTER=local

# From address for all outgoing emails
EMAIL_FROM=noreply@interviewflow.io
EMAIL_FROM_NAME=InterviewFlow

# SendGrid API key (only needed if EMAIL_ADAPTER=sendgrid)
SENDGRID_API_KEY=

# ─── Logging ────────────────────────────────────────────────
# Log level: debug | info | warning | error
LOG_LEVEL=debug

# ─── Feature Flags ──────────────────────────────────────────
# Enable async AI scoring (set to false to score synchronously in tests)
ENABLE_ASYNC_SCORING=true

# Enable calendar sync via Oban (requires Google Calendar OAuth credentials)
ENABLE_CALENDAR_SYNC=false

# ─── Google OAuth (Calendar Integration) ────────────────────
# Required only if ENABLE_CALENDAR_SYNC=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ─── SECRETS MANAGEMENT (read before editing) ───────────────
# Production secrets are stored in GCP Secret Manager.
# Naming convention: interviewflow-{environment}-{variable-name}
#
# Rotation policy:
#   SECRET_KEY_BASE      rotate every 6 months; keep old version 24h for session drain
#   GUARDIAN_SECRET_KEY  rotate every 6 months; keep old version 7 days for JWT expiry
#   DATABASE_PASSWORD    rotate quarterly via Cloud SQL IAM dual-credential switchover
#   TWILIO_AUTH_TOKEN    rotate immediately on compromise (Twilio secondary token pattern)
#   REDIS_PASSWORD       rotate quarterly via Memorystore AUTH update (no downtime)
#   SENDGRID_API_KEY     rotate quarterly; restrict to Mail Send scope only
#   AI_SERVICE_SECRET    rotate monthly; shared HMAC secret for internal service auth
#   SENTRY_DSN           rotate on team member offboarding
#   PROMETHEUS_AUTH_TOKEN rotate quarterly
#
# Rotation procedure:
#   1. gcloud secrets versions add interviewflow-{env}-{name} --data-file=-
#   2. Redeploy Cloud Run service (picks up 'latest' alias automatically)
#   3. Confirm health check passes, then disable old version
#
# PagerDuty alerting (dead-letter, error rate)
PAGERDUTY_INTEGRATION_KEY=
PAGERDUTY_ENABLED=false

# ─── Monitoring (optional in dev) ───────────────────────────
# Sentry DSN for error tracking (leave blank to disable)
# Rotation: generate new DSN client key on team member offboarding (revoke old key)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Sentry environment tag (mirrors MIX_ENV by default)
SENTRY_ENVIRONMENT=development

# Sentry release — set to GIT_SHA in CI for source-map linking
SENTRY_RELEASE=

# Sentry sample rate 0.0–1.0 (1.0 = capture all errors, reduce in high traffic)
SENTRY_SAMPLE_RATE=1.0

# Enable Sentry performance tracing (traces_sample_rate 0.0–1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry endpoint (leave blank to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Prometheus scrape path (metrics exposed by PromEx)
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_AUTH_TOKEN=replace_with_random_token_to_protect_metrics_endpoint

# Grafana Cloud (optional — for hosted metrics)
GRAFANA_CLOUD_URL=
GRAFANA_CLOUD_API_KEY=
