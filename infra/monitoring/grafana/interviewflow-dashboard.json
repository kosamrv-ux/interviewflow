{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "InterviewFlow Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "InterviewFlow operational dashboard — business KPIs, API performance, and AI scoring metrics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active Video Sessions",
      "type": "stat",
      "targets": [
        {
          "expr": "interviewflow_active_video_sessions",
          "legendFormat": "Active Sessions",
          "datasource": "${DS_PROMETHEUS}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Interviews Scheduled (24h)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(interviewflow_interviews_scheduled_total[24h])",
          "legendFormat": "Scheduled",
          "datasource": "${DS_PROMETHEUS}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Candidates Hired (24h)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(interviewflow_candidates_hired_total[24h])",
          "legendFormat": "Hired",
          "datasource": "${DS_PROMETHEUS}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["mean"] }
      },
      "title": "AI Score P95 Latency",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(interviewflow_ai_score_latency_seconds_bucket[5m]))",
          "legendFormat": "p95",
          "datasource": "${DS_PROMETHEUS}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "tooltip": { "mode": "multi" }
      },
      "title": "HTTP Request Rate by Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(phoenix_http_request_duration_milliseconds_count[1m]))",
          "legendFormat": "HTTP {{status}}",
          "datasource": "${DS_PROMETHEUS}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0 }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "HTTP Latency Percentiles",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(phoenix_http_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p50",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(phoenix_http_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(phoenix_http_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p99",
          "datasource": "${DS_PROMETHEUS}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "Pipeline Stage Advancements",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (from_stage, to_stage) (increase(interviewflow_applications_advanced_total[1h]))",
          "legendFormat": "{{from_stage}} -> {{to_stage}}",
          "datasource": "${DS_PROMETHEUS}"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "AI Scoring Latency Distribution",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(interviewflow_ai_score_latency_seconds_bucket[10m]))",
          "legendFormat": "p50",
          "datasource": "${DS_PROMETHEUS}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(interviewflow_ai_score_latency_seconds_bucket[10m]))",
          "legendFormat": "p95",
          "datasource": "${DS_PROMETHEUS}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["interviewflow", "production", "hrtech"],
  "templating": {
    "list": []
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "InterviewFlow — Operations",
  "uid": "interviewflow-ops-v1",
  "version": 1
}
