# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.ex      text eol=lf
*.exs     text eol=lf
*.heex    text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.env     text eol=lf
*.sql     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.toml    text eol=lf
*.lock    text eol=lf -diff
Makefile  text eol=lf

# Binary files - do not normalize
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.svg     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.otf     binary
*.pdf     binary
*.mp4     binary
*.webm    binary
*.zip     binary
*.tar.gz  binary
